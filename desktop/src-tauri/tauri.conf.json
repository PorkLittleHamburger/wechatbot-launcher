{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeChat OneBot Launcher",
  "version": "0.8.5",
  "identifier": "com.porklittlehamburger.wechat-onebot-launcher",
  "mainBinaryName": "wechat-onebot-launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WeChat OneBot Launcher",
        "width": 1140,
        "height": 760,
        "minWidth": 840,
        "minHeight": 560,
        "visible": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {"resources/runtime/": "runtime/", "resources/startup/": "startup/"},
    "windows": {
      "webviewInstallMode": {"type": "offlineInstaller", "silent": true},
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
